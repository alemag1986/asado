# Model endpoint (OpenAI-compatible). Unset = mock mode.
# Self-hosted llama-server:  MODEL_URL=http://127.0.0.1:8080/v1
# OpenRouter plan B:         MODEL_URL=https://openrouter.ai/api/v1  +  MODEL_API_KEY=sk-or-v1-...
MODEL_URL=http://127.0.0.1:8080/v1
MODEL_API_KEY=
# Model id sent to the endpoint: asado-4b for the self-hosted fine-tune,
# or an open-weight slug on OpenRouter, e.g. qwen/qwen3-vl-8b-instruct
MODEL_NAME=asado-4b

# API
BIND=0.0.0.0:4000
RUST_LOG=asado_api=info,tower_http=info

# Community feed (DigitalOcean Spaces, S3-compatible)
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_PUBLIC_BASE=
